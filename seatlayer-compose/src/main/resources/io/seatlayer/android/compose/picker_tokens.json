{
  "$schema": "https://seatlayer.io/schema/picker-tokens-1.json",
  "version": 1,
  "description": "Platform-neutral design tokens for the SeatLayer buyer picker chrome. The Flutter package generates its defaults from this file; the iOS, Android and React Native SDKs are expected to generate theirs from the same file so the four implementations cannot drift.",
  "color": {
    "light": {
      "background": "#F6F7FB",
      "surface": "#FFFFFF",
      "text": "#172033",
      "mutedText": "#667085",
      "divider": "#29172033",
      "error": "#B42318",
      "warning": "#F4B740",
      "accent": "#5B4B8A",
      "onAccent": "#FFFFFF",
      "mapBackground": "#E9EDF4",
      "mapRowLabel": "#334155",
      "mapText": "#172033",
      "mapSelection": "#5B4B8A"
    },
    "dark": {
      "background": "#0F1522",
      "surface": "#1A2234",
      "text": "#EEF1F8",
      "mutedText": "#A5AEC2",
      "divider": "#3DA5AEC2",
      "error": "#FF6B6B",
      "warning": "#F4B740",
      "accent": "#9B8AFB",
      "onAccent": "#110D20",
      "mapBackground": "#0F1522",
      "mapRowLabel": "#D7DEEA",
      "mapText": "#F4F7FB",
      "mapSelection": "#9B8AFB"
    }
  },
  "size": {
    "phoneBreakpoint": 640,
    "wideBreakpoint": 840,
    "headerHeight": 56,
    "headerLogoSize": 28,
    "dockBarHeight": 52,
    "peekHeight": 44,
    "sheetMaxHeightFraction": 0.6,
    "emptyTrayMaxHeight": 150,
    "denseLineHeight": 40,
    "denseVisibleLines": 5,
    "confirmCardGutter": 16,
    "confirmCardMaxWidth": 360,
    "confirmIdentityHeight": 44,
    "confirmPhotoHeight": 64,
    "confirmActionHeight": 40,
    "selectorHeight": 40,
    "accessibilityControlSize": 44,
    "mapControlSize": 36,
    "attributionHeight": 18,
    "legendChipFontSize": 11,
    "minimumHitTarget": 44
  },
  "radius": {
    "base": 14,
    "card": 18,
    "sheet": 14,
    "button": 8,
    "chip": 999,
    "pill": 999
  },
  "elevation": {
    "header": 0,
    "dockBar": 8,
    "sheet": 12,
    "confirmCard": 18,
    "pill": 0
  },
  "type": {
    "headerTitle": {
      "size": 16,
      "weight": 800
    },
    "dockSection": {
      "size": 14,
      "weight": 800
    },
    "dockCount": {
      "size": 13,
      "weight": 600
    },
    "confirmIdentity": {
      "size": 14,
      "weight": 800
    },
    "confirmAction": {
      "size": 14,
      "weight": 800
    },
    "denseLine": {
      "size": 13,
      "weight": 600
    },
    "peekSummary": {
      "size": 13,
      "weight": 800
    },
    "bookButton": {
      "size": 15,
      "weight": 800
    },
    "legendChip": {
      "size": 11,
      "weight": 800
    },
    "pill": {
      "size": 12,
      "weight": 800
    }
  },
  "motion": {
    "budgetMs": 420,
    "reducedMotion": "Every duration collapses to 0 ms when the viewer asks for less movement; motion with no reduced form (fly-to-tray, staggered arrival) is skipped rather than played instantly.",
    "duration": {
      "enter": 260,
      "exit": 180,
      "dock": 240,
      "sheet": 300,
      "fly": 420,
      "pop": 180,
      "stagger": 60,
      "crossfade": 120,
      "toast": 200,
      "immersive": 300
    },
    "durationOutsideBudget": {
      "undoWindow": 4000
    },
    "curve": {
      "spring": {
        "name": "easeOutBack",
        "cubicBezier": [
          0.34,
          1.56,
          0.64,
          1.0
        ]
      },
      "easeEnter": {
        "name": "easeOutCubic",
        "cubicBezier": [
          0.215,
          0.61,
          0.355,
          1.0
        ]
      },
      "easeExit": {
        "name": "easeInCubic",
        "cubicBezier": [
          0.55,
          0.055,
          0.675,
          0.19
        ]
      }
    }
  },
  "haptics": {
    "selectionAdded": "selection",
    "sectionFocused": "light",
    "holdCreated": "medium",
    "holdExpired": "heavy",
    "note": "The first snapshot of a session never fires a cue: a resumed focus or hold is not something the buyer just did."
  },
